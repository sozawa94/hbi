! Dilatancy test case for verification
! Problem: 3D planar fault with fluid injection and dilatancy

filenumber 203
problem 3dp
imax 40
jmax 40
ds 0.05
nstep 250
interval 10
tmax 3.0
dtout 0.05
a 0.015
b 0.020
dc 0.0005
f0 0.6
vref 1e-6
muinit 0.55
sigmainit 50.0
velinit 1e-9
backslip T
vpl 0d0

! Pressure diffusion with central injection
pressurediffusion T
injection flowrate
qinj 1e-9
tinj 3.0

! Fluid / pore properties
phi 0.1
beta 5e-8
eta 0.89e-3
kp 1e-13

! Permeability evolution
permev T
kpmin 1e-16
kpmax 1e-11
kT 1e15
kL 1e-3

! Dilatancy — the key parameters under test
dilatancy T
dilatancy_plastic  T
dilatancy_elastic  F
dilatancy_viscous  F
Ld 1.0
eps_d 2e-4
beta_phi 1e-8
eta_s 1e18